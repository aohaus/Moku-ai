{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && [ -d node_modules ] || npm install --no-audit --no-fund --silent"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^moku-(detective|fixer|guardian)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ux-agent-log.js\" hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^moku-(detective|fixer|guardian)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ux-agent-log.js\" hook"
          }
        ]
      }
    ]
  }
}
